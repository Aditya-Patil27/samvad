# copy to .env -- .env is gitignored, never commit it, never paste a key
# into a chat, an issue, or a screenshot. A key that has been seen anywhere
# shared is burned: rotate it rather than hoping.

# --- free-tier hosted models (pick either, or neither) -------------------
# https://console.groq.com/keys
GROQ_API_KEY=
# https://build.nvidia.com
NVIDIA_API_KEY=

# paid, and deliberately not wired up -- see src/samvad/llm/__init__.py
ANTHROPIC_API_KEY=

# shared HMAC secret -- must be BYTE-IDENTICAL on all four devices
# generate once:  python -c "import secrets; print(secrets.token_hex(32))"
SAMVAD_SECRET=

# which peer this device is
SAMVAD_AGENT=agent_a

# 1 = no API calls, no cost. Leave this on during development.
MOCK_LLM=1

# circuit breaker -- checked BEFORE every call
SAMVAD_MAX_USD_PER_HOUR=1.00
SAMVAD_MAX_CONCURRENCY=8

# inproc | loopback | lan
SAMVAD_TRANSPORT=lan
