  {
    "id": "t30",
    "task": "Order the nodes of a dependency graph. deps maps each node to the list of nodes it depends on; return a list holding every node, including nodes that appear only as dependencies, with each node after all of its dependencies. Raise ValueError if the dependencies contain a cycle",
    "constraints": [
      "Python 3.11",
      "standard library only"
    ],
    "function": "topo_sort",
    "signature": "topo_sort(deps: dict[str, list[str]]) -> list[str]",
    "tests": [
      "order = list(topo_sort({'app': ['lib', 'log'], 'lib': ['core'], 'log': ['core']}))",
      "assert sorted(order) == ['app', 'core', 'lib', 'log']",
      "assert order.index('core') < order.index('lib') < order.index('app')",
      "assert order.index('log') < order.index('app')",
      "assert list(topo_sort({})) == []",
      "try:",
      "    topo_sort({'a': ['b'], 'b': ['a']})",
      "    raise AssertionError('cycle not detected')",
      "except ValueError:",
      "    pass",
      "try:",
      "    topo_sort({'a': ['a']})",
      "    raise AssertionError('self-loop not detected')",
      "except ValueError:",
      "    pass"
    ]
  }
