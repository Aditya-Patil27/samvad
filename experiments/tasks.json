    "constraints": [
      "Python 3.11",
      "standard library only"
    ],
    "function": "merge_intervals",
    "signature": "merge_intervals(intervals: list[list[int]]) -> list[list[int]]",
    "tests": [
      "assert [list(p) for p in merge_intervals([[1, 3], [2, 6], [8, 10], [15, 18]])] == [[1, 6], [8, 10], [15, 18]]",
      "assert [list(p) for p in merge_intervals([[1, 4], [4, 5]])] == [[1, 5]]",
      "assert list(merge_intervals([])) == []",
      "assert [list(p) for p in merge_intervals([[8, 10], [1, 3], [2, 6]])] == [[1, 6], [8, 10]]",
      "assert [list(p) for p in merge_intervals([[1, 10], [2, 3]])] == [[1, 10]]"
    ]
  },
