      "assert fizzbuzz(5) == ['1', '2', 'Fizz', '4', 'Buzz']",
      "assert fizzbuzz(15)[-1] == 'FizzBuzz'",
      "assert fizzbuzz(15)[8] == 'Fizz'",
      "assert fizzbuzz(0) == []",
      "assert len(fizzbuzz(100)) == 100",
      "assert fizzbuzz(30)[29] == 'FizzBuzz'"
    ]
  },
  {
    "id": "t06",
    "task": "Count word frequencies in a text. A word is a maximal run of ASCII letters; every other character separates words. Counting is case-insensitive and the keys are lowercase",
    "constraints": [
      "Python 3.11",
      "standard library only"
    ],
    "function": "word_count",
    "signature": "word_count(text: str) -> dict[str, int]",
    "tests": [
      "assert word_count('The cat and the hat.') == {'the': 2, 'cat': 1, 'and': 1, 'hat': 1}",
      "assert word_count('') == {}",
      "assert word_count('Hello, hello... HELLO!') == {'hello': 3}",
      "assert word_count('one-two  three') == {'one': 1, 'two': 1, 'three': 1}",
      "assert word_count('a1b') == {'a': 1, 'b': 1}"
    ]
  },
  {
    "id": "t07",
    "task": "Given a list of integers and a target, return the indices (i, j) with i < j of two different positions whose values sum to the target, or None if there is no such pair. Inputs contain at most one valid pair",
    "constraints": [
      "O(n)",
      "Python 3.11",
      "standard library only"
    ],
    "function": "two_sum",
    "signature": "two_sum(nums: list[int], target: int) -> tuple[int, int] | None",
    "tests": [
      "assert two_sum([2, 7, 11, 15], 9) == (0, 1)",
      "assert two_sum([3, 2, 4], 6) == (1, 2)",
      "assert two_sum([3, 3], 6) == (0, 1)",
      "assert two_sum([5], 10) is None",
      "assert two_sum([1, 2, 3], 7) is None",
      "assert two_sum([1, 5, 9], 10) == (0, 2)"
    ]
  },
  {
    "id": "t08",
